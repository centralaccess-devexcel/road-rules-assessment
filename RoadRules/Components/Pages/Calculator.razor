@page "/calculator"
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using RoadRules.Data
@using RoadRules.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWeightCalculator Calc

<PageTitle>Weight calculator</PageTitle>
<h3>Weight calculator</h3>

<EditForm Model="input" OnValidSubmit="Calculate" FormName="calculator">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Jurisdiction</label>
        <InputSelect class="form-select" @bind-Value="input.JurisdictionCode">
            <option value="">Select...</option>
            @foreach (var j in jurisdictions)
            {
                <option value="@j.Code">@j.Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Axles in the group</label>
        <InputNumber class="form-control" @bind-Value="input.AxleCount" />
    </div>

    <button type="submit" class="btn btn-primary">Calculate</button>
</EditForm>

@if (result is not null)
{
    <p class="mt-3">
        Maximum for a @result.AxleGroup.ToLower() group in @result.JurisdictionCode:
        <strong>@result.MaxKg.ToString("N0") kg</strong>
    </p>
}
@if (error is not null)
{
    <p class="mt-3 text-danger">@error</p>
}

@code {
    private CalculatorInput input = new();
    private List<Jurisdiction> jurisdictions = new();
    private WeightResult? result;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        jurisdictions = await db.Jurisdictions.OrderBy(j => j.Name).ToListAsync();
    }

    private async Task Calculate()
    {
        result = null;
        error = null;
        try
        {
            result = await Calc.CalculateAsync(input.JurisdictionCode, input.AxleCount);
        }
        catch (Exception ex) when (ex is KeyNotFoundException or ArgumentOutOfRangeException)
        {
            error = ex.Message;
        }
    }

    public class CalculatorInput
    {
        [Required(ErrorMessage = "Pick a jurisdiction.")]
        public string JurisdictionCode { get; set; } = "";

        [Range(1, 3, ErrorMessage = "Axle count must be between 1 and 3.")]
        public int AxleCount { get; set; } = 1;
    }
}
